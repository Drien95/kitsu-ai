{
  "name": "kitsuai",
  "productName": "KitsuAI",
  "version": "5.6.0",
  "description": "Conseiller KitsuAI pour kitsu.games : panneau local, conseil en combat calcule sur le PC, analyses et entrainement",
  "author": "Drien95",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.drien95.kitsuai",
    "productName": "KitsuAI",
    "copyright": "KitsuAI, outil non officiel pour kitsu.games",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../moteur",
        "to": "moteur",
        "filter": [
          "**/*",
          "!engine/**",
          "!data/**",
          "!cache/**",
          "!resultats/**",
          "!_to_delete/**",
          "!*.bat",
          "!test-*.mjs"
        ]
      },
      {
        "from": "../kitsu_ai.user.js",
        "to": "kitsu_ai.user.js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "KitsuAI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KitsuAI",
      "uninstallDisplayName": "KitsuAI",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Drien95",
        "repo": "kitsu-ai",
        "releaseType": "release"
      }
    ]
  }
}